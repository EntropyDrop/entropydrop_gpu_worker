# Parallel v130/v131 deployment; substitute your local CUDA Python paths.
DENSE_UV_EXECUTION_MODE=resident
DENSE_UV_PRELOAD_MODEL_VERSION=SKING_DDJ_v130
DENSE_UV_PRELOAD_CHECKPOINT_FILE=SKING_DDJ_v130/parser.pt
DENSE_UV_PRELOAD_MAPPINGS_DIR=SKING_DDJ_v130/mappings
DENSE_UV_ALLOWED_MODEL_VERSIONS=SKING_DDJ_v130,SKING_DDJ_v131
SKING_DDJ_V130_PYTHON=/opt/conda/envs/uv-runtime/bin/python
SKING_DDJ_V131_PYTHON=/opt/conda/envs/uv-runtime/bin/python
